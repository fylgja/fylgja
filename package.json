{
  "name": "fylgja",
  "version": "2.3.0",
  "description": "The modular CSS library. Powered via CSS components",
  "homepage": "https://fylgja.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/fylgja/fylgja"
  },
  "bugs": "https://github.com/fylgja/fylgja/issues",
  "author": "Fylgja",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "fylgja",
    "css",
    "scss",
    "framework",
    "library",
    "metapackage"
  ],
  "bin": {
    "fylgja": "./bin/fylgja.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "test": "npx stylelint **/*.scss"
  },
  "dependencies": {
    "@fylgja/base": "^2.2.0",
    "@fylgja/tokens": "^2.3.0",
    "@fylgja/utilities": "^2.2.0"
  },
  "devDependencies": {
    "@fylgja/css-attr-polyfill": "^1.0.0",
    "@fylgja/stylelint-config": "^8.0.1",
    "lightningcss-cli": "^1.32.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.0",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2"
  },
  "stylelint": {
    "extends": "@fylgja/stylelint-config",
    "rules": {
      "scss/load-partial-extension": null,
      "scss/operator-no-unspaced": null
    },
    "ignoreFiles": [
      "**/_experiments/**/*"
    ]
  },
  "allowScripts": {
    "lightningcss-cli@1.33.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
